PORT=3001
NODE_ENV=production
CORS_ORIGIN=*

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere_para_uma_senha_forte
POSTGRES_DB=triton_db
DATABASE_URL=postgresql://postgres:altere_para_uma_senha_forte@postgres:5432/triton_db?schema=public

# JWT Authentication
JWT_SECRET=altere_para_uma_chave_jwt_secreta_longa

# Cloudflare R2 Object Storage
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_API_TOKEN=seu_api_token_aqui
R2_ACCESS_KEY_ID=seu_access_key_id_aqui
R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui
R2_BUCKET_NAME=triton-media
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
