PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/triton_db?schema=public"

# Cloudflare R2 Object Storage
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui
CLOUDFLARE_API_TOKEN=seu_api_token_aqui
R2_ACCESS_KEY_ID=seu_access_key_id_aqui
R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui
R2_BUCKET_NAME=triton-media
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
